{
  // Cloudflare Worker configuration for the OOMPF web index.
  // Set DATABASE_URL as a Wrangler/Cloudflare secret before deploying:
  //   bun run --filter='@oompf/database' migrate
  //   cd apps/web && bunx wrangler secret put DATABASE_URL
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oompf-web",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  // A custom entrypoint (rather than the adapter's
  // `@astrojs/cloudflare/entrypoints/server`) so the Worker can export a
  // `scheduled` handler alongside `fetch`. It delegates request handling to the
  // adapter's own handler, so Astro's asset serving, sessions and locals are
  // unchanged.
  "main": "./src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  // Public write endpoint (`POST /api/v1/profiles`): limit registrations per
  // IP so one caller cannot repeatedly trigger the two outbound GitHub fetches
  // and the Neon write behind a single POST. This is row-creation/egress
  // abuse, not SSRF (the fetch host is constrained by normalizeGistUrl).
  // The Simple scheme keys on client IP automatically. `namespace_id` is any
  // positive integer unique to this Worker; keep it stable across deploys.
  "ratelimits": [
    {
      "name": "PROFILE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  // Observability (GPS-142): Workers Logs is the whole production error and
  // traffic story. `invocation_logs` records method, path, status and outcome
  // per request, so first-party traffic and successful `POST /api/v1/profiles`
  // registrations are countable in the dashboard without an analytics
  // dependency; `console.error`/`console.warn` from the request and cron paths
  // land beside their invocation. Sampling stays at 1 — this Worker's volume
  // is nowhere near the free daily allowance, and a sampled log cannot answer
  // "did anything throw?".
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  // Source freshness (GPS-134): re-check indexed sources so a moved or deleted
  // Gist stops looking current. Runs inside the Worker, so there is no public
  // refresh endpoint and no shared secret to hold.
  "triggers": {
    "crons": ["0 */6 * * *"]
  }
}
