{
  // Cloudflare Worker configuration for the OOMPF web index.
  // Set DATABASE_URL as a Wrangler/Cloudflare secret before deploying:
  //   bun run --filter='@oompf/database' migrate
  //   cd apps/web && bunx wrangler secret put DATABASE_URL
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oompf-web",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  // Public write endpoint (`POST /api/v1/profiles`): limit registrations per
  // IP so one caller cannot repeatedly trigger the two outbound GitHub fetches
  // and the Neon write behind a single POST. This is row-creation/egress
  // abuse, not SSRF (the fetch host is constrained by normalizeGistUrl).
  // The Simple scheme keys on client IP automatically. `namespace_id` is any
  // positive integer unique to this Worker; keep it stable across deploys.
  "ratelimits": [
    {
      "name": "PROFILE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
