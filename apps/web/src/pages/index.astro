---
/**
 * OOMPF home. The hero states the whole product as a transcript — publish,
 * index, install, run — because that loop is the thesis. Below it the index
 * itself is the content: one ledger row per profile, shaped like OMP's own
 * output, plus the documentation entry points a first-time visitor needs.
 *
 * Rendered on the Worker; the repository comes from the Cloudflare runtime env
 * and degrades to a directed notice when the binding is unavailable.
 */
import Base from "../layouts/Base.astro";
import {
  type AppLocals,
  type CompactProfile,
  IndexError,
  listFeaturedProfiles,
  resolveRepository,
  searchIndexedProfiles,
} from "../lib/services/index-profile.ts";

export const prerender = false;

const queryParam = Astro.url.searchParams.get("q");
const q = (queryParam ?? "").trim();
const cursorParam = Astro.url.searchParams.get("cursor");
// The bare home (no `q`/`cursor` params) is the pin: an honest recency top-5.
// Any explicit search params put the page in the full, cursor-paginated
// listing (the header search submits `/?q=` — an empty but *present* `q` here
// means "browse all", not "home").
const featuredHome = queryParam === null && cursorParam === null;
const locals = Astro.locals as unknown as AppLocals;

let profiles: readonly CompactProfile[] = [];
let nextCursor: string | null = null;
let dbError: string | null = null;
try {
  const repository = await resolveRepository(locals);
  if (featuredHome) {
    profiles = await listFeaturedProfiles(repository);
  } else {
    const page = await searchIndexedProfiles(
      repository,
      q,
      undefined,
      cursorParam
    );
    profiles = page.results;
    nextCursor = page.nextCursor;
  }
} catch (error) {
  dbError =
    error instanceof IndexError
      ? error.message
      : "The index is unreachable right now. The profiles themselves are unaffected — they live on GitHub.";
}

const heading = featuredHome
  ? "Recently shared"
  : q === ""
    ? "All profiles"
    : `Matches for “${q}”`;

/** Build the no-JS "next page" link carrying the keyset cursor. */
function nextPageHref(cursor: string, query: string): string {
  const params = new URLSearchParams();
  params.set("q", query);
  params.set("cursor", cursor);
  return `/?${params.toString()}`;
}

/** Shorten an opaque profile id for display; the page carries the full one. */
function shortId(id: string): string {
  return id.length > 16 ? `${id.slice(0, 14)}…` : id;
}

const docsRail = [
  {
    body: "What a profile actually is, which fields OOMPF reads, and where the runtime authority stays.",
    href: "/docs/omp-profiles",
    role: "concept",
    title: "OMP profiles",
  },
  {
    body: "Turn a local profile into a public Gist, scan it for secrets, and register its metadata.",
    href: "/docs/publishing-a-profile",
    role: "publish",
    title: "Publishing",
  },
  {
    body: "Install someone else's profile by its OOMPF URL, and what happens when the name collides.",
    href: "/docs/installing-a-profile",
    role: "install",
    title: "Installing",
  },
];
---

<Base>
  <div class="wrap">
    <section class="hero">
      <h1>
        Share a working OMP profile as <span class="accent">one link</span>.
      </h1>
      <p class="lede">
        Profiles get passed around as screenshots and half a YAML file. OOMPF
        indexes them from public GitHub Gists, shows the facts —
        <strong>models, providers, advisors, hooks, prerequisites</strong>
        — and hands back a command that installs the profile natively.
      </p>

      <div class="hero-demo">
        <div class="transcript">
          <div class="transcript-bar">
            <span>◆</span><span>the whole loop</span>
          </div>
          <pre
            class="transcript-body"
          ><span class="cmd">oompf publish daily-driver</span><span
              class="out"
            >  <span class="ok">✓</span> gist      gist.github.com/alice/cfcdad13…</span><span
              class="out"
            >  <span class="ok">✓</span> indexed   oompf.run/p/prof_00e08f39…</span><span class="cmd">oompf add https://oompf.run/p/prof_00e08f39…</span><span
              class="out"
            >  <span class="ok">✓</span> installed ~/.omp/profiles/alice-daily-driver</span><span class="cmd">omp --profile alice-daily-driver<span
                class="cursor"
                aria-hidden="true"></span></span></pre>
        </div>

        <aside class="pi-panel">
          <div class="pi-panel-bar">
            <span aria-hidden="true">◇</span>
            <a href="https://omp.sh/" rel="noopener noreferrer" target="_blank"
              >built for OMP (oh my pi) -- learn more ↗</a
            >
          </div>
          <div class="pi-field">
            <svg
              aria-hidden="true"
              class="pi-mark"
              height="9.25rem"
              viewBox="0 0 64 64"
              width="min(86%, 22rem)"
            >
              <defs>
                <clipPath id="pi-mark-clip">
                  <path d="M10 14h44v9H43v33h-9V23h-9v22h-9V23H10z"></path>
                </clipPath>
              </defs>
              <path
                class="pi-mark-base"
                d="M10 14h44v9H43v33h-9V23h-9v22h-9V23H10z"
              ></path>
              <g clip-path="url(#pi-mark-clip)">
                <g class="pi-code-plane pi-code-plane-s">
                  <g id="pi-code-tile-s">
                    <text class="pi-code-stack-a" x="0" y="24">
                      oompf publish → resolveProfile() → validateArtifact()
                    </text>
                    <text class="pi-code-stack-b" x="-22" y="39">
                      validateArtifact() → createPublicProfileGist() →
                      registerProfile()
                    </text>
                    <text class="pi-code-stack-c" x="16" y="53">
                      registerProfile() → indexed → oompf.run/p/prof_00e08f39
                    </text>
                  </g>
                  <use href="#pi-code-tile-s" x="-140"></use>
                  <use href="#pi-code-tile-s" x="140"></use>
                  <use href="#pi-code-tile-s" x="280"></use>
                </g>
                <g class="pi-code-plane pi-code-plane-m">
                  <g id="pi-code-tile-m">
                    <text class="pi-code-brand-oompf" x="2" y="28">oompf</text>
                    <text class="pi-code-brand-pi" x="33" y="31">π</text>
                    <text class="pi-code-brand-omp" x="48" y="37">omp</text>
                    <text class="pi-code-brand-pi" x="12" y="46">π</text>
                    <text class="pi-code-brand-oompf" x="39" y="51">oompf</text>
                    <text class="pi-code-brand-omp" x="20" y="56">omp</text>
                  </g>
                  <use href="#pi-code-tile-m" x="-74"></use>
                  <use href="#pi-code-tile-m" x="74"></use>
                  <use href="#pi-code-tile-m" x="148"></use>
                </g>
                <g class="pi-code-plane pi-code-plane-l">
                  <g id="pi-code-tile-l">
                    <text class="pi-code-sigil-warm" x="3" y="20">$</text>
                    <text class="pi-code-sigil-green" x="31" y="19">#</text>
                    <text class="pi-code-sigil-violet" x="16" y="34">@</text>
                    <text class="pi-code-sigil-warm" x="48" y="40">$</text>
                    <text class="pi-code-sigil-green" x="8" y="51">#</text>
                    <text class="pi-code-sigil-violet" x="39" y="55">@</text>
                  </g>
                  <use href="#pi-code-tile-l" x="-60"></use>
                  <use href="#pi-code-tile-l" x="60"></use>
                  <use href="#pi-code-tile-l" x="120"></use>
                </g>
              </g>
            </svg>
          </div>
        </aside>
      </div>
    </section>

    <section class="section">
      <h2>{heading}</h2>
      {dbError !== null ? (
          <p class="notice">{dbError}</p>
        ) : profiles.length === 0 ? (
          <p class="empty">
            {q === ""
              ? "Nothing indexed yet. Publish a profile with oompf publish, or register a public Gist URL."
              : `No profile matches “${q}”. Search a model selector, a provider, or a profile name.`}
          </p>
        ) : (
          <div class="ledger">
            {profiles.map((profile) => (
              <a class="ledger-row" href={profile.url}>
                <span class="ledger-head">
                  <span class="ledger-name">{profile.name}</span>
                  {profile.owner !== null && (
                    <span class="ledger-owner">@{profile.owner}</span>
                  )}
                  {profile.kind !== null && (
                    <span class="kind-chip">{profile.kind.value}</span>
                  )}
                  {profile.structural === "invalid" && (
                    <span class="badge invalid">invalid</span>
                  )}
                </span>
                {profile.summary !== null && (
                  <p class="ledger-summary">{profile.summary}</p>
                )}
                <span class="ledger-facts">
                  <div>
                    <span class="ledger-key">models</span>
                    <span class="model">
                      {profile.models.length === 0
                        ? "none declared"
                        : profile.models.slice(0, 3).join(" · ")}
                      {profile.models.length > 3 &&
                        ` +${profile.models.length - 3}`}
                    </span>
                  </div>
                  {profile.providers.length > 0 && (
                    <div>
                      <span class="ledger-key">providers</span>
                      <span class="provider">
                        {profile.providers.join(" · ")}
                      </span>
                    </div>
                  )}
                  <div>
                    <span class="ledger-key">install</span>
                    <span class="ledger-cmd">
                      oompf add oompf.run/p/{shortId(profile.id)}
                    </span>
                  </div>
                </span>
              </a>
            ))}
          </div>
        )}
      {featuredHome && profiles.length > 0 && (
          <p class="browse">
            <a href="/?q=">Browse all profiles →</a>
          </p>
        )}
      {!featuredHome && nextCursor !== null && (
          <p class="browse">
            <a href={nextPageHref(nextCursor, q)}>Next page →</a>
          </p>
        )}
    </section>

    <section class="section">
      <h2>Start here</h2>
      <p class="section-note">
        OOMPF documents the shareable profile format. OMP remains the authority
        for how a profile behaves once it is installed.
      </p>
      <div class="docs-rail">
        {docsRail.map((card) => (
          <article class="docs-rail-card">
            <span class="step">{card.role}</span>
            <h3><a href={card.href}>{card.title}</a></h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</Base>
