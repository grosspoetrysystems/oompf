---
/**
 * Profile detail: compact, human-facing facts for one indexed OMP profile.
 *
 * Trust coordinates and providers sit next to the title, models preserve their
 * exact selectors in a two-column grid, and behavior uses the same friendly
 * names without repeating provider/model noise. Empty requirements and runtime
 * alias inventories stay out of the way. The canonical install command remains
 * one paste, while source, revision, and fingerprint are always one click away.
 */

import { resolveModelDisplay, resolveProviderLink } from "@oompf/core";
import type { ProfileRecord } from "@oompf/database";
import Base from "../../layouts/Base.astro";
import { buildProfileMeta } from "../../lib/profile-meta.ts";
import { buildProfileView } from "../../lib/profile-view.ts";
import {
  type AppLocals,
  getProfileMetadata,
  IndexError,
  resolveRepository,
} from "../../lib/services/index-profile.ts";

export const prerender = false;

const id = Astro.params.id ?? "";
const locals = Astro.locals as unknown as AppLocals;

let record: ProfileRecord | null = null;
let errorMessage: string | null = null;
try {
  const repository = await resolveRepository(locals);
  record = await getProfileMetadata(repository, id);
} catch (error) {
  if (error instanceof IndexError && error.code === "not_found") {
    Astro.response.status = 404;
    errorMessage = error.message;
  } else if (error instanceof IndexError) {
    Astro.response.status = error.status;
    errorMessage = error.message;
  } else {
    Astro.response.status = 500;
    errorMessage = "The index is temporarily unavailable.";
  }
}

const view =
  record === null
    ? null
    : buildProfileView(record, {
        resolveModel: resolveModelDisplay,
        resolveProvider: resolveProviderLink,
        siteOrigin: Astro.site?.origin ?? null,
      });

// Per-profile Open Graph / Twitter meta. The og:image lands on the request
// origin (resolved against the canonical profile URL) so crawlers fetch an
// absolute, raster thumbnail — svg logos are not widely supported there.
const meta = view === null ? null : buildProfileMeta(view);
const ogImage =
  meta === null
    ? undefined
    : new URL("/android-chrome-512x512.png", meta.url).href;
---

<Base
  title={meta !== null ? meta.title : "Profile — OOMPF"}
  description={meta !== null ? meta.description : undefined}
  ogDescription={meta?.description}
  ogImage={ogImage}
  ogTitle={meta?.title}
  ogType="article"
  ogUrl={meta?.url}
>
  <div class="wrap">
    {view === null ? (
        <section class="hero">
          <h1>Profile not found</h1>
          <p class="notice">{errorMessage}</p>
          <p><a href="/">← Back to the index</a></p>
        </section>
      ) : (
        <article class="profile">
          <header class="profile-header">
            <div class="profile-title">
              <h1>{view.profileName}</h1>
              <span
                class={`badge ${view.structuralValid ? "valid" : "invalid"}`}
              >
                {view.structuralValid
                  ? "structurally valid"
                  : "structurally invalid"}
              </span>
              {view.ompVersion !== null && (
                <span class="badge">omp {view.ompVersion}</span>
              )}
            </div>

            {view.summary !== null && (
              <p class="profile-summary">{view.summary}</p>
            )}

            <div class="profile-meta">
              {view.kind !== null && (
                <span
                  class="kind-chip"
                  title={
                    view.kind.controlled ? "Standard kind" : "Custom kind"
                  }
                >
                  {view.kind.value}
                </span>
              )}
              {view.tags.length > 0 && (
                <span class="tag-row">
                  {view.tags.map((tag) => (
                    <span class="tag">#{tag}</span>
                  ))}
                </span>
              )}
              {view.owner !== null && (
                <span class="attribution">
                  by{" "}
                  <a
                    href={`https://github.com/${view.owner}`}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    @{view.owner}
                  </a>
                </span>
              )}
            </div>

            {view.links.length > 0 && (
              <ul class="curated-links">
                {view.links.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      {link.label} ↗
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </header>

          <section
            aria-label="Profile source and providers"
            class:list={[
              "profile-context",
              { "source-only": view.providers.length === 0 },
            ]}
          >
            {view.providers.length > 0 && (
              <div class="context-group">
                <h2>Providers</h2>
                <div class="chip-row">
                  {view.providers.map((provider) =>
                    provider.url !== null ? (
                      <a
                        class="tag linked"
                        href={provider.url}
                        rel="noopener noreferrer"
                        target="_blank"
                      >
                        {provider.displayName} ↗
                      </a>
                    ) : (
                      <span class="tag">{provider.displayName}</span>
                    )
                  )}
                </div>
              </div>
            )}

            <div class="context-group source-context">
              <h2>Source</h2>
              <div class="source-links">
                <a
                  href={view.provenance.sourceUrl}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  GitHub source ↗
                </a>
                {view.provenance.revisionUrl !== null &&
                  view.provenance.revision !== null && (
                    <a
                      href={view.provenance.revisionUrl}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      Pinned{" "}
                      <code>{view.provenance.revision.slice(0, 8)}</code> ↗
                    </a>
                  )}
                {view.provenance.indexedAt !== null &&
                  view.provenance.indexedLabel !== null && (
                    <span>
                      Indexed{" "}
                      <time datetime={view.provenance.indexedAt}>
                        {view.provenance.indexedLabel}
                      </time>
                    </span>
                  )}
                <span class="fingerprint">
                  <code title={`SHA-256 ${view.provenance.contentHash}`}>
                    sha256 {view.provenance.contentHash.slice(0, 8)}…
                    {view.provenance.contentHash.slice(-4)}
                  </code>
                  <button
                    aria-label="Copy SHA-256 content fingerprint"
                    class="inline-copy-btn"
                    data-copy={view.provenance.contentHash}
                    type="button"
                  >
                    Copy hash
                  </button>
                </span>
              </div>
            </div>
          </section>

          <section class="install" aria-labelledby="install-label">
            <span class="section-eyebrow" id="install-label">Install</span>
            <div class="copy-row">
              <code id="install-cmd">{view.installCommand}</code>
              <button
                class="ghost copy-btn"
                type="button"
                data-copy={view.installCommand}
                aria-label="Copy install command"
              >
                Copy
              </button>
            </div>
            <p class="section-note">
              Installs as a native OMP profile. Nothing is overwritten — a name
              collision fails instead.{" "}
              <a href="/docs/installing-a-profile">How installing works</a>
            </p>
          </section>

          <section class="detail-section" aria-labelledby="models-heading">
            <h2 id="models-heading">Models</h2>
            <p class="section-note">
              Friendly name first; exact selector beneath.{" "}
              <a href="/docs/models-and-providers">Model resolution</a>
            </p>
            {view.models.length > 0 ? (
              <ul class="model-list">
                {view.models.map((model) => (
                  <li class="model-item">
                    <div class="model-head">
                      {model.url !== null ? (
                        <a
                          class="model-name"
                          href={model.url}
                          rel="noopener noreferrer"
                          target="_blank"
                        >
                          {model.friendlyName} ↗
                        </a>
                      ) : (
                        <span class="model-name">{model.friendlyName}</span>
                      )}
                      {model.thinkingLevel !== null && (
                        <span class="thinking-badge">
                          thinking {model.thinkingLevel}
                        </span>
                      )}
                    </div>
                    <code class="model-selector" title={model.selector}>
                      {model.selector}
                    </code>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="none">
                No concrete models are declared in this profile.
              </p>
            )}
          </section>


          {view.behavior.present && (
            <section class="detail-section" aria-labelledby="behavior-heading">
              <h2 id="behavior-heading">Behavior</h2>
              <div class="facts">
                {view.behavior.modelRoles.length > 0 && (
                  <div class="fact">
                    <h3>Model roles</h3>
                    <ul>
                      {view.behavior.modelRoles.map((entry) => (
                        <li class="behavior-line">
                          <span class="role">{entry.role}</span>
                          <span aria-hidden="true">→</span>
                          <span
                            class="behavior-model"
                            title={entry.model.selector}
                          >
                            {entry.model.friendlyName}
                          </span>
                          {entry.model.thinkingLevel !== null && (
                            <span class="thinking-badge">
                              thinking {entry.model.thinkingLevel}
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {view.behavior.fallbackChains.length > 0 && (
                  <div class="fact">
                    <h3>Fallback chains</h3>
                    <ul>
                      {view.behavior.fallbackChains.map((chain) => (
                        <li class="behavior-line">
                          <span class="role">{chain.role}</span>
                          <span aria-hidden="true">→</span>
                          <span class="behavior-chain">
                            {chain.models.map((model, index) => (
                              <>
                                {index > 0 && (
                                  <span aria-hidden="true">→</span>
                                )}
                                <span
                                  class="behavior-model"
                                  title={model.selector}
                                >
                                  {model.friendlyName}
                                </span>
                                {model.thinkingLevel !== null && (
                                  <span class="thinking-badge">
                                    thinking {model.thinkingLevel}
                                  </span>
                                )}
                              </>
                            ))}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {view.behavior.advisor.length > 0 && (
                  <div class="fact">
                    <h3>Advisor</h3>
                    <dl class="setting-list">
                      {view.behavior.advisor.map((setting) => (
                        <>
                          <dt>{setting.label}</dt>
                          <dd>{setting.value}</dd>
                        </>
                      ))}
                    </dl>
                  </div>
                )}
                {view.behavior.settings.length > 0 && (
                  <div class="fact">
                    <h3>Settings</h3>
                    <dl class="setting-list">
                      {view.behavior.settings.map((setting) => (
                        <>
                          <dt>{setting.label}</dt>
                          <dd>{setting.value}</dd>
                        </>
                      ))}
                    </dl>
                  </div>
                )}
                {view.behavior.hooks.length > 0 && (
                  <div class="fact">
                    <h3>Hooks</h3>
                    <ul>
                      {view.behavior.hooks.map((hook) => (
                        <li>{hook}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {view.behavior.extensions.length > 0 && (
                  <div class="fact">
                    <h3>Extensions</h3>
                    <ul>
                      {view.behavior.extensions.map((extension) => (
                        <li>{extension}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {view.behavior.disabledProviders.length > 0 && (
                  <div class="fact">
                    <h3>Disabled providers</h3>
                    <div class="chip-row">
                      {view.behavior.disabledProviders.map((provider) => (
                        <span class="tag">{provider}</span>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </section>
          )}

          {view.requirements.length > 0 && (
            <section
              class="detail-section"
              aria-labelledby="requirements-heading"
            >
              <h2 id="requirements-heading">Requirements</h2>
              <ul class="requirement-list">
                {view.requirements.map((req) => (
                  <li class="requirement">
                    <div class="req-head">
                      <code class="req-name">{req.name}</code>
                      <span class="req-kind">{req.kindLabel}</span>
                    </div>
                    <p class="req-reason">{req.reason}</p>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {view.warnings.length > 0 && (
            <section class="warnings" aria-labelledby="warnings-heading">
              <h3 id="warnings-heading">Warnings</h3>
              <ul>
                {view.warnings.map((warning) => (
                  <li>{warning}</li>
                ))}
              </ul>
            </section>
          )}

        </article>
      )}
  </div>
</Base>

<script>
  const buttons =
    document.querySelectorAll<HTMLButtonElement>("button[data-copy]");
  for (const button of buttons) {
    button.addEventListener("click", async () => {
      const text = button.dataset.copy ?? "";
      const original = button.textContent;
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Copy failed";
      }
      setTimeout(() => {
        button.textContent = original;
      }, 1500);
    });
  }
</script>
