# Required for the Astro Cloudflare Worker and database migrations.
# Use a Neon pooled/serverless Postgres connection string. Do not commit a real value.
DATABASE_URL=

# Optional for local CLI smoke against a non-production OOMPF web endpoint.
OOMPF_BASE_URL=http://localhost:4321

# Required only in GitHub Actions deployment secrets, not in local files.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
