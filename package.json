{
  "name": "oompf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check:migrations": "bun scripts/check-migrations.ts",
    "check:package": "bun scripts/check-package.ts",
    "db:migrate": "bun scripts/with-env.ts -- bun run --filter=@oompf/database migrate",
    "dev": "bun run --filter='@oompf/web' dev",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "gate": "bun run lint && bun run knip && bun run test && bun run typecheck && bun run build && bun run check:migrations && bun run check:package && bun run smoke:local",
    "knip": "knip",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "prepare": "bun scripts/prepare-lefthook.ts",
    "smoke:deployed": "bun scripts/smoke-deployed.ts",
    "smoke:local": "bun test tests/e2e/oompf-flow.test.ts",
    "smoke:published": "bun scripts/smoke-published.ts",
    "test": "bun test --path-ignore-patterns='**/dist/**'",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:vitest": "vitest run --passWithNoTests",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@electric-sql/pglite": "0.5.4",
    "@oompf/core": "workspace:*",
    "@oompf/database": "workspace:*",
    "@oompf/github": "workspace:*",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-orm": "0.45.2",
    "knip": "6.32.0",
    "lefthook": "2.1.10",
    "tsdown": "0.22.14",
    "tsx": "4.23.11",
    "turbo": "2.10.9",
    "typescript": "5.9.2",
    "ultracite": "7.10.2",
    "vitest": "4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
